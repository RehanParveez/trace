APP_NAME=Trace
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8015
FRONTEND_PORT=5094

POSTGRES_DB=trace
POSTGRES_USER=trace
POSTGRES_PASSWORD=postpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trace:trace@postgres:5432/trace

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/2

CELERY_BROKER_URL=redis://redis:6379/4
CELERY_RESULT_BACKEND=redis://redis:6379/5

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=trace
MINIO_SECRET_KEY=trace-dev-secret
MINIO_BUCKET=trace
MINIO_SECURE=false

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ur
DEFAULT_CURRENCY=PKR
DEFAULT_TIMEZONE=Asia/Karachi

CORS_ORIGINS=http://localhost:5085
